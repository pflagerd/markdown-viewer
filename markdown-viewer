#!/usr/bin/env bash
#
# Usage: markdown-viewer [--devtools] [--] [FILE...]
#        markdown-viewer --headless [--devtools]
#        markdown-viewer --stop
#        markdown-viewer -h | --help
#
# Opens each FILE in the installed Markdown Viewer PWA. Without FILE, or when
# the PWA is not installed yet, opens the app itself.
#
# The app is served by a small local server (node server.js) that the launcher
# starts in the background when needed. It exits by itself 30 seconds after
# the last app window has closed.
#
# Options:
#   --headless   Start only the server, print its URL and exit; no browser is
#                started. This server never exits by itself (use --stop). A
#                server already running on the port is replaced.
#   --devtools   Let the browser's developer-tools keys (F12, Ctrl+Shift+I, ...)
#                through to the browser. Stays in effect until the next launch
#                without --devtools.
#   --stop       Stop the server running on the port, if any.
#   -h, --help   Show this help.
#   --           End of options; everything after it is a FILE.
#
# Environment:
#   MARKDOWN_VIEWER_PORT     localhost port the app is served on (default 8137).
#                            The port is part of the PWA's identity: changing it
#                            means installing the app again.
#   MARKDOWN_VIEWER_BROWSER  Chrome/Chromium executable to use (default: the one
#                            that installed the PWA, else the first found on PATH).
#   MARKDOWN_VIEWER_INSTALLED  Set to 1 to skip the "is the PWA installed?" check,
#                            if the launcher fails to detect an existing install.

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(dirname "$SELF")"
APP_DIR="$ROOT_DIR/app"
SERVER="$ROOT_DIR/server.js"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

die() { echo "markdown-viewer: $*" >&2; exit 1; }
usage_error() { echo "markdown-viewer: $*" >&2; echo "Try 'markdown-viewer --help'." >&2; exit 2; }

# ---- arguments ---------------------------------------------------------------

HEADLESS=0
DEVTOOLS=0
STOP=0
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '3,34s/^# \{0,1\}//p' "$SELF"; exit 0 ;;
    --headless) HEADLESS=1 ;;
    --devtools) DEVTOOLS=1 ;;
    --stop) STOP=1 ;;
    --) shift; ARGS+=("$@"); break ;;
    -?*) usage_error "unknown option: $1" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

if [ "$STOP" = 1 ] && { [ "$HEADLESS" = 1 ] || [ "$DEVTOOLS" = 1 ] || [ ${#ARGS[@]} -gt 0 ]; }; then
  usage_error "--stop cannot be combined with other options or files"
fi
if [ "$HEADLESS" = 1 ] && [ ${#ARGS[@]} -gt 0 ]; then
  usage_error "--headless starts no browser, so it takes no files"
fi

PORT="${MARKDOWN_VIEWER_PORT:-8137}"
[[ "$PORT" =~ ^[0-9]+$ ]] || die "MARKDOWN_VIEWER_PORT is not a port number: $PORT"
ORIGIN="http://localhost:${PORT}"

# Checked before anything is started, so a typo has no side effects.
FILES=()
for f in ${ARGS[@]+"${ARGS[@]}"}; do
  [ -f "$f" ] || die "no such file: $f"
  FILES+=("$(readlink -f -- "$f")")
done

command -v node >/dev/null || die "node (Node.js 18 or newer) is required"
[ -f "$APP_DIR/index.html" ] || die "app directory not found: $APP_DIR"
[ -f "$SERVER" ] || die "server not found: $SERVER"

# ---- server ------------------------------------------------------------------

# Where the server keeps its pid file and looks for the devtools flag; must be
# the directory server.js computes.
STATE_DIR="${XDG_RUNTIME_DIR:-}"
[ -n "$STATE_DIR" ] || STATE_DIR="$(node -p 'require("os").tmpdir()')"
PID_FILE="$STATE_DIR/markdown-viewer-$PORT.pid"
DEVTOOLS_FILE="$STATE_DIR/markdown-viewer-$PORT.devtools"

listening() { (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null; }

# Prints the pid of our server for this port, if the pid file names a live
# process that really is node running server.js (pids get reused).
server_pid() {
  local pid args=()
  [ -f "$PID_FILE" ] || return 1
  pid="$(tr -cd '0-9' <"$PID_FILE")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  mapfile -d '' args <"/proc/$pid/cmdline" 2>/dev/null || return 1
  [ ${#args[@]} -ge 2 ] || return 1
  [[ "${args[0]##*/}" == node* ]] || return 1
  local a
  for a in "${args[@]:1}"; do
    if [[ "${a##*/}" == server.js ]]; then echo "$pid"; return 0; fi
  done
  return 1
}

# Returns 1 if no server was running.
stop_server() {
  local pid
  pid="$(server_pid)" || return 1
  kill "$pid" 2>/dev/null || true
  # Not "kill -0": an exited server can linger as a zombie until it is reaped.
  for _ in $(seq 50); do [ "$(server_pid)" = "$pid" ] || return 0; sleep 0.1; done
  die "server (pid $pid) did not stop"
}

# The server keeps running after this script exits.
start_server() {
  setsid node "$SERVER" --port "$PORT" "$@" >/dev/null 2>&1 </dev/null &
  for _ in $(seq 50); do listening && return 0; sleep 0.1; done
  die "could not start the local server on port $PORT"
}

if [ "$STOP" = 1 ]; then
  rm -f -- "$DEVTOOLS_FILE"
  if stop_server; then
    echo "markdown-viewer: stopped the server on port $PORT"
  else
    echo "markdown-viewer: no server was running on port $PORT"
  fi
  exit 0
fi

# The app asks the server for this flag when a window starts.
if [ "$DEVTOOLS" = 1 ]; then
  : >"$DEVTOOLS_FILE"
else
  rm -f -- "$DEVTOOLS_FILE"
fi

if [ "$HEADLESS" = 1 ]; then
  # A server started by a normal launch would exit when idle; replace it.
  stop_server || true
  listening && die "port $PORT is in use by another program"
  start_server --headless
  echo "$ORIGIN/"
  exit 0
fi

# Something else may hold the port (for example the python server an older
# version of this launcher left running); the app would then load without /api.
ours() {
  (
    exec 3<>"/dev/tcp/127.0.0.1/${PORT}"
    printf 'GET /api/config HTTP/1.0\r\nHost: localhost:%s\r\nConnection: close\r\n\r\n' "$PORT" >&3
    timeout 5 grep -q '"devtools"' <&3
  ) 2>/dev/null
}

if listening; then
  ours || die "port $PORT is in use by another program; stop it or set MARKDOWN_VIEWER_PORT"
else
  start_server
fi

# ---- browser -----------------------------------------------------------------

# Chromium derives a web app's ID from its manifest id (here "$ORIGIN/"):
# SHA-256 twice, first 16 bytes, hex digits 0-f written as letters a-p.
APP_ID="$(node -e '
  const { createHash } = require("crypto");
  const sha256 = (data) => createHash("sha256").update(data).digest();
  const hex = sha256(sha256(process.argv[1])).subarray(0, 16).toString("hex");
  console.log(hex.replace(/./g, (c) => "abcdefghijklmnop"[parseInt(c, 16)]));
' "$ORIGIN/")"

# Chrome writes one desktop entry per installed PWA; its Exec line names the
# browser binary and profile that own the installation.
DESKTOP_FILE=""
for f in "$DESKTOP_DIR"/chrome-"$APP_ID"-*.desktop \
         "$HOME"/snap/chromium/current/.local/share/applications/chrome-"$APP_ID"-*.desktop; do
  [ -f "$f" ] && { DESKTOP_FILE="$f"; break; }
done

BROWSER="${MARKDOWN_VIEWER_BROWSER:-}"
PROFILE_ARG=()
if [ -n "$DESKTOP_FILE" ]; then
  exec_line="$(grep -m1 '^Exec=' "$DESKTOP_FILE" | cut -d= -f2-)"
  if [ -z "$BROWSER" ]; then
    candidate="${exec_line%% *}"
    [ -x "$candidate" ] && BROWSER="$candidate"
  fi
  profile="$(sed -n 's/.*--profile-directory=\("[^"]*"\|[^ ]*\).*/\1/p' <<<"$exec_line" | tr -d '"')"
  [ -n "$profile" ] && PROFILE_ARG=("--profile-directory=$profile")
fi
if [ -z "$BROWSER" ]; then
  for b in google-chrome-stable google-chrome chromium chromium-browser; do
    if command -v "$b" >/dev/null; then BROWSER="$b"; break; fi
  done
fi
[ -n "$BROWSER" ] || die "no Chrome/Chromium found; set MARKDOWN_VIEWER_BROWSER"

if [ -z "$DESKTOP_FILE" ] && [ "${MARKDOWN_VIEWER_INSTALLED:-}" != 1 ]; then
  echo "markdown-viewer: the app is not installed yet." >&2
  echo "  Click 'Install' in the window that opens, then run this command again." >&2
  "$BROWSER" "--app=$ORIGIN/" >/dev/null 2>&1 &
  exit 0
fi

"$BROWSER" ${PROFILE_ARG[@]+"${PROFILE_ARG[@]}"} "--app-id=$APP_ID" \
  ${FILES[@]+"${FILES[@]}"} >/dev/null 2>&1 &
